# --- core ---
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://hssngram.hssn.my.id
# ArvanCloud managed PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/hssngram
PGSSL=require

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_DAYS=60

# open = anyone can register (admin must approve), invite = invite code required, closed = first user only
REGISTRATION_MODE=open
REQUIRE_APPROVAL=true
MIGRATE_ON_START=true

# --- storage: s3 (ArvanCloud Object Storage) or local ---
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=hssngram
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=200
# used only when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# --- calls (WebRTC) ---
STUN_URLS=stun:stun.arvancloud.ir:3478,stun:stun.l.google.com:19302
TURN_URLS=turn:turn.hssn.my.id:3478,turns:turn.hssn.my.id:5349
TURN_SECRET=replace-me-coturn-static-auth-secret
TURN_TTL_SECONDS=3600
MAX_CALL_PARTICIPANTS=4

# --- web push (optional) ---
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hssn.my.id

WEB_DIST=../web/dist
LOG_LEVEL=info

# --- first admin (npm run seed) ---
ADMIN_LOGIN_ID=10000000
ADMIN_PASSWORD=427726
ADMIN_DISPLAY_NAME=حسن
